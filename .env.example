# Optional: set this to enable live OpenRouter processing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Keep debug disabled outside local development.
FLASK_DEBUG=false
# Optional: set a long random secret for local sessions.
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Comma-separated exact hostnames permitted for Workflow Builder HTTP Request actions.
# Requests are HTTPS-only; redirects and private/reserved destination IPs are blocked.
OPSPILOT_HTTP_ALLOWED_HOSTS=
